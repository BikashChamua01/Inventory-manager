{
  "name": "inventory-manager",
  "version": "1.0.0",
  "description": "Offline Windows Inventory Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma skills sync || exit 0",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:frontend && npm run build:electron && electron-builder",
    "build:frontend": "npm --prefix frontend run build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "db:reset-data": "node scripts/reset-database.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "build": {
    "appId": "com.inventorymanager.desktop",
    "productName": "Inventory Manager",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "electron/**/*",
      "backend/**/*",
      "generated/prisma/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "prisma/schema.prisma",
      "prisma.config.ts"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}